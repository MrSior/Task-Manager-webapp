<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="serviceName" source="spring.application.name" defaultValue="task-manager"/>
    <springProperty scope="context" name="processType" source="app.process-type" defaultValue="web"/>
    <property name="HOSTNAME" value="${HOSTNAME:-unknown}"/>

    <!-- JSON в stdout — формат для сбора логов в k8s -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <message>
                    <fieldName>message</fieldName>
                </message>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <mdc/>
                <stackTrace>
                    <fieldName>error.stack_trace</fieldName>
                </stackTrace>
                <pattern>
                    <pattern>
                        {
                          "service.name": "${serviceName}",
                          "service.version": "1.0.0",
                          "service.instance.id": "${HOSTNAME}",
                          "process.type": "${processType}"
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
